NODE_ENV=development
PORT=4000
API_TIMEOUT_MS=2000

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sara567

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# IMB Payment Gateway (deposit) + Payout (withdraw)
# Dashboard: API Credentials → user_token → IMB_API_KEY
# Webhook (deposit): https://YOUR_DOMAIN/api/v1/wallet/imb/webhook
# Payout callback:   https://YOUR_DOMAIN/api/v1/wallet/imb/payout-webhook
IMB_MERCHANT_ID=demo-merchant
IMB_API_KEY=your-imb-user-token
IMB_WEBHOOK_SECRET=
IMB_BASE_URL=https://api.imbpay.in/v2
IMB_REDIRECT_URL=https://YOUR_DOMAIN/deposit/done
IMB_PAYOUT_BASE_URL=https://secure.imbpayment.com/api/v1
IMB_PAYOUT_TOKEN=your-imb-payout-token
IMB_SENDER_NAME=SARA567
IMB_MOCK=true

# OTP / SMS — Jaipur SMS Hub
OTP_MOCK=false
OTP_SMS_URL=https://sms.jaipursmshub.in/api_v2/message/send
OTP_SMS_API_KEY=
OTP_SMS_SENDER_ID=PTPSMS
OTP_SMS_DLT_TEMPLATE_ID=
OTP_SMS_MESSAGE=Hi Your User OTP is: {otp} Thank you ! COMPANY NAME PTPSMS
OTP_TTL_SECONDS=300
PUBLIC_BASE_URL=http://127.0.0.1:4000

# Optional Redis (falls back to memory if unreachable)
REDIS_URL=

# Market scraper — live results + extra scrape markets merged with DB (seed/admin)
# Example: https://your-results-site.com/
SCRAPE_URL=

# Firebase Cloud Messaging (service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
