NODE_ENV=development
PORT=4000
API_TIMEOUT_MS=2000

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sara567

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# IMB single merchant
IMB_MERCHANT_ID=demo-merchant
IMB_API_KEY=demo-api-key
IMB_WEBHOOK_SECRET=demo-webhook-secret
IMB_BASE_URL=https://api.imb.example/v1
IMB_MOCK=true

# OTP / SMS — jaise hi aap API doge, OTP_MOCK=false + URL/KEY set karo
OTP_MOCK=true
OTP_SMS_URL=
OTP_SMS_API_KEY=
OTP_TTL_SECONDS=300
PUBLIC_BASE_URL=http://127.0.0.1:4000

# Optional Redis (falls back to memory if unreachable)
REDIS_URL=
